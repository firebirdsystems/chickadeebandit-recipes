{
  "manifest": {
    "id": "recipes",
    "name": "Recipes",
    "version": "1.0.0",
    "description": "A household recipe book with ingredients, steps, categories, ratings, and difficulty. Add any recipe's ingredients directly to your grocery list.",
    "entrypoint": "index.html",
    "runtime": "static",
    "storage": "db",
    "category": "home",
    "tags": [
      "recipes",
      "food",
      "cooking",
      "ingredients"
    ],
    "exports": [
      "recipes"
    ],
    "data_access": {
      "reads": [
        "family.members"
      ],
      "writes": [
        "app.grocery.pending_items"
      ]
    },
    "permissions": {
      "default_audience": "everyone",
      "requires_approval": false
    },
    "resource_limits": {
      "max_db_bytes": 104857600
    },
    "nav": {
      "label": "Recipes"
    },
    "widget": {
      "label": "Recipes",
      "size": "small"
    },
    "icon": "📖"
  },
  "migrations": [
    {
      "version": 1,
      "sql": "CREATE TABLE IF NOT EXISTS categories (\n  household_id UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id           TEXT NOT NULL,\n  name         TEXT NOT NULL,\n  color        TEXT NOT NULL DEFAULT '#6b7280',\n  created_at   TEXT NOT NULL,\n  PRIMARY KEY (household_id, id)\n);"
    },
    {
      "version": 2,
      "sql": "CREATE TABLE IF NOT EXISTS recipes (\n  household_id    UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id              TEXT NOT NULL,\n  title           TEXT NOT NULL,\n  description     TEXT NOT NULL DEFAULT '',\n  category_id     TEXT,\n  difficulty      TEXT NOT NULL DEFAULT 'medium',\n  servings        INTEGER NOT NULL DEFAULT 4,\n  total_time_mins INTEGER,\n  source          TEXT NOT NULL DEFAULT '',\n  rating          INTEGER,\n  notes           TEXT NOT NULL DEFAULT '',\n  created_by_id   TEXT NOT NULL,\n  created_by_name TEXT NOT NULL,\n  created_at      TEXT NOT NULL,\n  updated_at      TEXT NOT NULL,\n  PRIMARY KEY (household_id, id)\n);"
    },
    {
      "version": 3,
      "sql": "CREATE TABLE IF NOT EXISTS ingredients (\n  household_id UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id           TEXT NOT NULL,\n  recipe_id    TEXT NOT NULL,\n  name         TEXT NOT NULL,\n  amount       TEXT NOT NULL DEFAULT '',\n  unit         TEXT NOT NULL DEFAULT '',\n  sort_order   INTEGER NOT NULL DEFAULT 0,\n  PRIMARY KEY (household_id, id)\n);"
    },
    {
      "version": 4,
      "sql": "CREATE TABLE IF NOT EXISTS steps (\n  household_id UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id           TEXT NOT NULL,\n  recipe_id    TEXT NOT NULL,\n  instruction  TEXT NOT NULL,\n  sort_order   INTEGER NOT NULL DEFAULT 0,\n  PRIMARY KEY (household_id, id)\n);"
    }
  ],
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Recipes</title>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    :root {\n      --bg:           var(--hub-bg, #f9fafb);\n      --card:         var(--hub-surface, #ffffff);\n      --border:       var(--hub-border, #e5e7eb);\n      --text:         var(--hub-text, #111827);\n      --muted:        var(--hub-text-muted, #6b7280);\n      --accent:       var(--hub-primary, #111827);\n      --accent-hover: var(--hub-primary-hover, #374151);\n      --accent-fg:    var(--hub-primary-fg, #fff);\n      --radius:       var(--hub-radius, 0.5rem);\n      --shadow:       0 1px 3px rgba(0,0,0,.07);\n      --green: #059669; --amber: #d97706; --red: #dc2626;\n      --amber-bg: #fffbeb; --amber-border: #fcd34d;\n      --green-bg: #f0fdf4; --red-bg: #fef2f2;\n    }\n\n    body {\n      font-family: var(--hub-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif);\n      background: var(--bg); color: var(--text);\n      font-size: var(--hub-font-size, 15px); line-height: 1.5;\n      min-height: 100vh;\n    }\n\n    .app { max-width: 640px; margin: 0 auto; padding: 16px; }\n\n    /* ── Top bar ── */\n    .topbar {\n      display: flex; align-items: center; gap: 8px; margin-bottom: 14px; flex-wrap: wrap;\n    }\n    .topbar-back {\n      background: none; border: none; color: var(--muted); font-size: 1.1rem;\n      cursor: pointer; padding: 4px 6px; border-radius: 6px; line-height: 1;\n    }\n    .topbar-back:hover { background: var(--border); color: var(--text); }\n    .topbar-title { font-size: 1.1rem; font-weight: 700; flex: 1; }\n    .topbar-actions { display: flex; gap: 6px; }\n\n    /* ── Search & filters ── */\n    .search-row { display: flex; gap: 8px; margin-bottom: 10px; }\n    .search-input {\n      flex: 1; border: 1.5px solid var(--border); border-radius: 8px;\n      padding: 8px 12px; font-size: 0.9rem; background: var(--card);\n      outline: none; font-family: inherit; color: var(--text);\n    }\n    .search-input:focus { border-color: var(--accent); }\n    .filter-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }\n    .chip {\n      padding: 4px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600;\n      border: 1.5px solid var(--border); background: var(--card); color: var(--muted);\n      cursor: pointer; white-space: nowrap; transition: all .15s;\n    }\n    .chip.active { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }\n    .sort-select {\n      border: 1.5px solid var(--border); border-radius: 8px; padding: 4px 8px;\n      font-size: 0.8rem; background: var(--card); color: var(--text);\n      outline: none; font-family: inherit; cursor: pointer; margin-left: auto;\n    }\n\n    /* ── Recipe cards ── */\n    .recipe-grid { display: flex; flex-direction: column; gap: 8px; }\n    .recipe-card {\n      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);\n      padding: 14px 16px; cursor: pointer; transition: border-color .15s, box-shadow .15s;\n      box-shadow: var(--shadow);\n    }\n    .recipe-card:hover { border-color: var(--accent); box-shadow: 0 2px 8px rgba(0,0,0,.1); }\n    .recipe-card-title { font-weight: 700; font-size: 1rem; margin-bottom: 4px; }\n    .recipe-card-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n    .badge {\n      display: inline-block; padding: 2px 7px; border-radius: 999px;\n      font-size: 0.72rem; font-weight: 700; color: white;\n    }\n    .badge-easy   { background: var(--green); }\n    .badge-medium { background: var(--amber); }\n    .badge-hard   { background: var(--red); }\n    .badge-cat    { background: #6366f1; }\n    .meta-text { font-size: 0.8rem; color: var(--muted); }\n    .stars { color: #f59e0b; font-size: 0.85rem; letter-spacing: -.05em; }\n\n    /* ── FAB ── */\n    .fab {\n      position: fixed; bottom: 24px; right: 24px;\n      width: 52px; height: 52px; border-radius: 50%;\n      background: var(--accent); color: var(--accent-fg);\n      border: none; font-size: 1.5rem; cursor: pointer;\n      box-shadow: 0 4px 12px rgba(0,0,0,.2); transition: background .15s, transform .1s;\n      display: flex; align-items: center; justify-content: center;\n    }\n    .fab:hover { background: var(--accent-hover); transform: scale(1.05); }\n\n    /* ── Detail view ── */\n    .detail-meta-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 10px 0; }\n    .detail-section { margin-top: 18px; }\n    .detail-section h3 { font-size: 0.75rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 10px; }\n    .ingredient-list { list-style: none; }\n    .ingredient-list li { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem; }\n    .ingredient-list li:last-child { border-bottom: none; }\n    .step-list { list-style: none; counter-reset: steps; }\n    .step-list li { counter-increment: steps; display: flex; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem; }\n    .step-list li:last-child { border-bottom: none; }\n    .step-list li::before {\n      content: counter(steps); min-width: 24px; height: 24px; border-radius: 50%;\n      background: var(--accent); color: var(--accent-fg); display: flex;\n      align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;\n      flex-shrink: 0; margin-top: 1px;\n    }\n    .source-link { font-size: 0.85rem; color: #2563eb; word-break: break-all; }\n    .notes-text { font-size: 0.9rem; color: var(--muted); font-style: italic; white-space: pre-wrap; }\n    .detail-footer {\n      display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px;\n      padding-top: 16px; border-top: 1px solid var(--border);\n    }\n    .btn {\n      padding: 9px 16px; border-radius: 8px; font-size: 0.875rem; font-weight: 600;\n      cursor: pointer; border: none; transition: all .15s; font-family: inherit;\n    }\n    .btn-primary { background: var(--accent); color: var(--accent-fg); }\n    .btn-primary:hover { background: var(--accent-hover); }\n    .btn-primary:disabled { opacity: .45; cursor: default; }\n    .btn-amber { background: var(--amber-bg); color: #92400e; border: 1.5px solid var(--amber-border); }\n    .btn-amber:hover { background: #fef3c7; }\n    .btn-ghost { background: none; color: var(--muted); border: 1.5px solid var(--border); }\n    .btn-ghost:hover { border-color: var(--text); color: var(--text); }\n    .btn-danger { background: var(--red-bg); color: var(--red); border: 1.5px solid #fecaca; }\n    .btn-danger:hover { background: #fee2e2; }\n\n    /* ── Form ── */\n    .form-card {\n      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);\n      padding: 20px; box-shadow: var(--shadow);\n    }\n    .field { margin-bottom: 14px; }\n    label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: .04em; }\n    input[type=text], input[type=number], textarea, select {\n      width: 100%; border: 1.5px solid var(--border); border-radius: 8px;\n      padding: 8px 12px; font-size: 0.92rem; font-family: inherit; color: var(--text);\n      background: var(--card); outline: none; transition: border-color .15s;\n    }\n    input[type=text]:focus, input[type=number]:focus, textarea:focus, select:focus { border-color: var(--accent); }\n    textarea { resize: vertical; min-height: 72px; }\n\n    .difficulty-group { display: flex; gap: 8px; }\n    .diff-btn {\n      flex: 1; padding: 7px; border-radius: 8px; border: 1.5px solid var(--border);\n      background: var(--card); font-size: 0.85rem; font-weight: 600; cursor: pointer;\n      transition: all .15s; font-family: inherit; color: var(--muted);\n    }\n    .diff-btn.easy.active  { background: var(--green-bg); border-color: var(--green); color: var(--green); }\n    .diff-btn.medium.active { background: var(--amber-bg); border-color: var(--amber); color: var(--amber); }\n    .diff-btn.hard.active  { background: var(--red-bg);   border-color: var(--red);   color: var(--red); }\n\n    .stars-input { display: flex; gap: 4px; }\n    .star-btn { background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #d1d5db; padding: 0 2px; transition: color .1s; }\n    .star-btn.on { color: #f59e0b; }\n\n    .ing-row, .step-row {\n      display: flex; gap: 6px; align-items: flex-start; margin-bottom: 6px;\n    }\n    .ing-amount { width: 72px; flex-shrink: 0; }\n    .ing-unit   { width: 80px; flex-shrink: 0; }\n    .ing-name   { flex: 1; }\n    .step-row textarea { flex: 1; min-height: 54px; }\n    .row-del { background: none; border: none; color: var(--muted); font-size: 1.1rem; cursor: pointer; padding: 8px 6px; border-radius: 6px; flex-shrink: 0; }\n    .row-del:hover { background: var(--red-bg); color: var(--red); }\n    .add-row-btn {\n      background: none; border: 1.5px dashed var(--border); border-radius: 8px;\n      color: var(--muted); font-size: 0.85rem; font-weight: 600; padding: 7px 12px;\n      cursor: pointer; width: 100%; transition: all .15s; font-family: inherit;\n    }\n    .add-row-btn:hover { border-color: var(--accent); color: var(--accent); }\n\n    .form-actions { display: flex; gap: 8px; margin-top: 20px; justify-content: flex-end; }\n\n    /* ── Toast ── */\n    .toast {\n      position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);\n      background: #1f2937; color: #f9fafb; padding: 10px 18px; border-radius: 8px;\n      font-size: 0.875rem; font-weight: 500; box-shadow: 0 4px 12px rgba(0,0,0,.3);\n      z-index: 200; pointer-events: none; opacity: 0; transition: opacity .2s;\n      white-space: nowrap;\n    }\n    .toast.show { opacity: 1; }\n    .toast.error { background: #7f1d1d; }\n\n    /* ── Modal ── */\n    .modal-backdrop {\n      position: fixed; inset: 0; background: rgba(0,0,0,.4);\n      display: flex; align-items: center; justify-content: center;\n      padding: 16px; z-index: 100;\n    }\n    .modal {\n      background: var(--card); border-radius: 12px; padding: 20px;\n      width: 100%; max-width: 380px; box-shadow: 0 8px 32px rgba(0,0,0,.2);\n    }\n    .modal h3 { font-size: 1rem; font-weight: 700; margin-bottom: 14px; }\n    .modal-actions { display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end; }\n\n    /* ── Empty / loading ── */\n    .empty { text-align: center; padding: 48px 16px; color: var(--muted); }\n    .empty-icon { font-size: 3rem; margin-bottom: 10px; }\n    .loading { text-align: center; padding: 48px; color: var(--muted); }\n  </style>\n<base href=\"/run/recipes/\">\n</head>\n<body>\n<div class=\"app\">\n  <div id=\"root\"><div class=\"loading\">Loading…</div></div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script type=\"module\">\nimport { esc, hubConfirm, crossWrite } from \"/hub-sdk.js\";\nimport { formatIngredient, formatTime, difficultyLabel, difficultyColor, starDisplay, sortRecipes } from \"./logic.js\";\n\nconst DB      = window.__DB_URL         ?? \"\";\nconst CONTEXT = window.__CONTEXT_URL    ?? \"\";\nconst STORE   = window.__STORE_URL      ?? \"\";\nconst ME      = window.__CURRENT_MEMBER ?? null;\n\n// ── State ─────────────────────────────────────────────────────────────────────\nlet view = \"list\"; // \"list\" | \"detail\" | \"form\"\nlet recipes = [], categories = [];\nlet currentRecipe = null; // full recipe with ingredients + steps\nlet editingId = null;\nlet filterCat = \"\", filterDiff = \"\", sortBy = \"title\";\nlet searchQ = \"\";\n\n// Form state\nlet formIngredients = [{ amount: \"\", unit: \"\", name: \"\" }];\nlet formSteps       = [{ instruction: \"\" }];\nlet formDifficulty  = \"medium\";\nlet formRating      = 0;\n\n// ── DB ────────────────────────────────────────────────────────────────────────\nasync function db(sql, params = []) {\n  if (!DB) return { rows: [] };\n  const res = await fetch(DB, {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ sql, params }),\n  });\n  const json = await res.json();\n  if (json.error) throw new Error(json.error);\n  return json;\n}\n\n// ── Data loading ──────────────────────────────────────────────────────────────\nasync function loadAll() {\n  const [rRes, cRes] = await Promise.all([\n    db(`SELECT * FROM recipes ORDER BY title`),\n    db(`SELECT * FROM categories ORDER BY name`),\n  ]);\n  recipes = rRes.rows;\n  categories = cRes.rows;\n}\n\nasync function loadRecipeFull(id) {\n  const [rRes, iRes, sRes] = await Promise.all([\n    db(`SELECT * FROM recipes WHERE id = ?`, [id]),\n    db(`SELECT * FROM ingredients WHERE recipe_id = ? ORDER BY sort_order`, [id]),\n    db(`SELECT * FROM steps WHERE recipe_id = ? ORDER BY sort_order`, [id]),\n  ]);\n  if (!rRes.rows[0]) return null;\n  return { ...rRes.rows[0], ingredients: iRes.rows, steps: sRes.rows };\n}\n\n// ── KV export sync ────────────────────────────────────────────────────────────\nasync function syncExport() {\n  if (!STORE) return;\n  try {\n    const { rows } = await db(`SELECT * FROM recipes ORDER BY title`);\n    const exported = [];\n    for (const r of rows) {\n      const { rows: ings } = await db(\n        `SELECT name, amount, unit FROM ingredients WHERE recipe_id = ? ORDER BY sort_order`, [r.id]\n      );\n      exported.push({\n        id: r.id, title: r.title, category_id: r.category_id,\n        difficulty: r.difficulty, servings: r.servings,\n        total_time_mins: r.total_time_mins, rating: r.rating,\n        ingredients: ings,\n      });\n    }\n    await fetch(STORE, {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ key: \"recipes\", value: JSON.stringify(exported) }),\n    });\n  } catch { /* non-fatal */ }\n}\n\n// ── Grocery integration ───────────────────────────────────────────────────────\nasync function addToGrocery(recipe) {\n  if (!recipe.ingredients?.length) {\n    showToast(\"No ingredients to add\", \"error\"); return;\n  }\n  const ops = recipe.ingredients.map(ing => ({\n    op: \"array_append\", path: \"items\",\n    value: { name: formatIngredient(ing), addedBy: recipe.title },\n  }));\n  try {\n    await crossWrite(\"grocery\", \"pending_items\", ops);\n    showToast(`${recipe.ingredients.length} item${recipe.ingredients.length !== 1 ? \"s\" : \"\"} added to grocery list`);\n  } catch {\n    showToast(\"Grocery app not available\", \"error\");\n  }\n}\n\n// ── Category CRUD ─────────────────────────────────────────────────────────────\nfunction openCategoryModal() {\n  const modal = document.createElement(\"div\");\n  modal.className = \"modal-backdrop\";\n  modal.innerHTML = `\n    <div class=\"modal\">\n      <h3>Manage Categories</h3>\n      <div id=\"cat-list\" style=\"margin-bottom:12px\">\n        ${categories.map(c => `\n          <div style=\"display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border)\">\n            <span style=\"width:14px;height:14px;border-radius:50%;background:${esc(c.color)};flex-shrink:0;display:inline-block\"></span>\n            <span style=\"flex:1;font-size:0.9rem\">${esc(c.name)}</span>\n            <button onclick=\"deleteCategory('${esc(c.id)}')\" class=\"row-del\" title=\"Delete\">✕</button>\n          </div>`).join(\"\") || '<p style=\"color:var(--muted);font-size:0.85rem\">No categories yet</p>'}\n      </div>\n      <div style=\"display:flex;gap:6px;align-items:center\">\n        <input id=\"new-cat-name\" type=\"text\" placeholder=\"Category name\" style=\"flex:1;padding:7px 10px;border:1.5px solid var(--border);border-radius:7px;font-size:0.9rem;font-family:inherit;color:var(--text);background:var(--card);outline:none\" />\n        <input id=\"new-cat-color\" type=\"color\" value=\"#6366f1\" style=\"width:36px;height:36px;border:1.5px solid var(--border);border-radius:7px;cursor:pointer;padding:2px\" />\n        <button class=\"btn btn-primary\" style=\"padding:7px 12px\" onclick=\"addCategory()\">Add</button>\n      </div>\n      <div class=\"modal-actions\">\n        <button class=\"btn btn-ghost\" onclick=\"this.closest('.modal-backdrop').remove()\">Done</button>\n      </div>\n    </div>`;\n  modal.addEventListener(\"click\", e => { if (e.target === modal) modal.remove(); });\n  document.body.appendChild(modal);\n}\n\nwindow.addCategory = async function() {\n  const nameEl  = document.getElementById(\"new-cat-name\");\n  const colorEl = document.getElementById(\"new-cat-color\");\n  const name = nameEl.value.trim();\n  if (!name) { nameEl.focus(); return; }\n  const id = crypto.randomUUID();\n  await db(`INSERT INTO categories (id, name, color, created_at) VALUES (?, ?, ?, ?)`,\n    [id, name, colorEl.value, new Date().toISOString()]);\n  nameEl.value = \"\";\n  await loadAll();\n  document.querySelector(\".modal-backdrop\")?.remove();\n  openCategoryModal();\n  renderForm();\n};\n\nwindow.deleteCategory = async function(id) {\n  if (!await hubConfirm({ message: \"Delete this category?\", confirmLabel: \"Delete\", destructive: true })) return;\n  await db(`DELETE FROM categories WHERE id = ?`, [id]);\n  await db(`UPDATE recipes SET category_id = NULL WHERE category_id = ?`, [id]);\n  await loadAll();\n  document.querySelector(\".modal-backdrop\")?.remove();\n  openCategoryModal();\n  renderForm();\n};\n\n// ── Recipe CRUD ───────────────────────────────────────────────────────────────\nasync function saveRecipe() {\n  const title = document.getElementById(\"f-title\")?.value.trim();\n  if (!title) { document.getElementById(\"f-title\")?.focus(); return; }\n\n  const btn = document.querySelector(\".form-actions .btn-primary\");\n  if (btn) { btn.disabled = true; btn.textContent = \"Saving…\"; }\n\n  const now = new Date().toISOString();\n  const ings = formIngredients.filter(i => i.name.trim());\n  const steps = formSteps.filter(s => s.instruction.trim());\n\n  try {\n    const data = {\n      title,\n      description: document.getElementById(\"f-desc\")?.value.trim() ?? \"\",\n      category_id: document.getElementById(\"f-cat\")?.value || null,\n      difficulty:  formDifficulty,\n      servings:    parseInt(document.getElementById(\"f-servings\")?.value) || 4,\n      total_time_mins: parseInt(document.getElementById(\"f-time\")?.value) || null,\n      source:      document.getElementById(\"f-source\")?.value.trim() ?? \"\",\n      rating:      formRating || null,\n      notes:       document.getElementById(\"f-notes\")?.value.trim() ?? \"\",\n    };\n\n    if (editingId) {\n      await db(`UPDATE recipes SET title=?,description=?,category_id=?,difficulty=?,servings=?,total_time_mins=?,source=?,rating=?,notes=?,updated_at=? WHERE id=?`,\n        [data.title, data.description, data.category_id, data.difficulty, data.servings,\n         data.total_time_mins, data.source, data.rating, data.notes, now, editingId]);\n      await db(`DELETE FROM ingredients WHERE recipe_id = ?`, [editingId]);\n      await db(`DELETE FROM steps WHERE recipe_id = ?`, [editingId]);\n      for (let i = 0; i < ings.length; i++) {\n        await db(`INSERT INTO ingredients (id, recipe_id, name, amount, unit, sort_order) VALUES (?, ?, ?, ?, ?, ?)`,\n          [crypto.randomUUID(), editingId, ings[i].name, ings[i].amount, ings[i].unit, i]);\n      }\n      for (let i = 0; i < steps.length; i++) {\n        await db(`INSERT INTO steps (id, recipe_id, instruction, sort_order) VALUES (?, ?, ?, ?)`,\n          [crypto.randomUUID(), editingId, steps[i].instruction, i]);\n      }\n    } else {\n      const id = crypto.randomUUID();\n      const who = ME?.id ?? \"demo\";\n      const whoName = ME?.name ?? \"Demo\";\n      await db(`INSERT INTO recipes (id, title, description, category_id, difficulty, servings, total_time_mins, source, rating, notes, created_by_id, created_by_name, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n        [id, data.title, data.description, data.category_id, data.difficulty, data.servings,\n         data.total_time_mins, data.source, data.rating, data.notes, who, whoName, now, now]);\n      for (let i = 0; i < ings.length; i++) {\n        await db(`INSERT INTO ingredients (id, recipe_id, name, amount, unit, sort_order) VALUES (?, ?, ?, ?, ?, ?)`,\n          [crypto.randomUUID(), id, ings[i].name, ings[i].amount, ings[i].unit, i]);\n      }\n      for (let i = 0; i < steps.length; i++) {\n        await db(`INSERT INTO steps (id, recipe_id, instruction, sort_order) VALUES (?, ?, ?, ?)`,\n          [crypto.randomUUID(), id, steps[i].instruction, i]);\n      }\n      editingId = id;\n    }\n\n    await Promise.all([loadAll(), syncExport()]);\n    currentRecipe = await loadRecipeFull(editingId);\n    view = \"detail\";\n    render();\n  } catch (e) {\n    showToast(\"Save failed — try again\", \"error\");\n    if (btn) { btn.disabled = false; btn.textContent = \"Save\"; }\n  }\n}\n\nasync function deleteRecipe(id) {\n  if (!await hubConfirm({ message: \"Delete this recipe?\", confirmLabel: \"Delete\", destructive: true })) return;\n  await db(`DELETE FROM ingredients WHERE recipe_id = ?`, [id]);\n  await db(`DELETE FROM steps WHERE recipe_id = ?`, [id]);\n  await db(`DELETE FROM recipes WHERE id = ?`, [id]);\n  await Promise.all([loadAll(), syncExport()]);\n  currentRecipe = null;\n  view = \"list\";\n  render();\n}\n\n// ── Form helpers ──────────────────────────────────────────────────────────────\nfunction addIngredientRow(ing = { amount: \"\", unit: \"\", name: \"\" }) {\n  formIngredients.push(ing);\n}\nfunction removeIngredientRow(i) {\n  formIngredients.splice(i, 1);\n  if (!formIngredients.length) formIngredients.push({ amount: \"\", unit: \"\", name: \"\" });\n}\nfunction addStepRow() { formSteps.push({ instruction: \"\" }); }\nfunction removeStepRow(i) {\n  formSteps.splice(i, 1);\n  if (!formSteps.length) formSteps.push({ instruction: \"\" });\n}\n\nfunction captureFormState() {\n  formIngredients = Array.from(document.querySelectorAll(\".ing-row\")).map(row => ({\n    amount: row.querySelector(\".ing-amount\")?.value.trim() ?? \"\",\n    unit:   row.querySelector(\".ing-unit\")?.value.trim()   ?? \"\",\n    name:   row.querySelector(\".ing-name\")?.value.trim()   ?? \"\",\n  }));\n  formSteps = Array.from(document.querySelectorAll(\".step-row textarea\")).map(el => ({\n    instruction: el.value.trim(),\n  }));\n}\n\n// ── Rendering ─────────────────────────────────────────────────────────────────\nfunction render() {\n  if (view === \"list\")   renderList();\n  else if (view === \"detail\") renderDetail();\n  else if (view === \"form\")   renderForm();\n}\n\nfunction renderList() {\n  let filtered = recipes;\n  if (searchQ) filtered = filtered.filter(r => r.title.toLowerCase().includes(searchQ.toLowerCase()));\n  if (filterCat)  filtered = filtered.filter(r => r.category_id === filterCat);\n  if (filterDiff) filtered = filtered.filter(r => r.difficulty  === filterDiff);\n  filtered = sortRecipes(filtered, sortBy);\n\n  const catOptions = categories.map(c =>\n    `<button class=\"chip${filterCat === c.id ? \" active\" : \"\"}\" onclick=\"setFilterCat('${c.id}')\">${esc(c.name)}</button>`\n  ).join(\"\");\n\n  const diffChips = [\"easy\", \"medium\", \"hard\"].map(d =>\n    `<button class=\"chip${filterDiff === d ? \" active\" : \"\"}\" onclick=\"setFilterDiff('${d}')\">${difficultyLabel(d)}</button>`\n  ).join(\"\");\n\n  const cards = filtered.length ? filtered.map(r => {\n    const cat = categories.find(c => c.id === r.category_id);\n    return `\n      <div class=\"recipe-card\" onclick=\"openDetail('${r.id}')\">\n        <div class=\"recipe-card-title\">${esc(r.title)}</div>\n        <div class=\"recipe-card-meta\">\n          <span class=\"badge badge-${r.difficulty}\">${difficultyLabel(r.difficulty)}</span>\n          ${cat ? `<span class=\"badge badge-cat\" style=\"background:${esc(cat.color)}\">${esc(cat.name)}</span>` : \"\"}\n          ${r.total_time_mins ? `<span class=\"meta-text\">⏱ ${formatTime(r.total_time_mins)}</span>` : \"\"}\n          ${r.servings ? `<span class=\"meta-text\">👥 ${r.servings}</span>` : \"\"}\n          ${r.rating ? `<span class=\"stars\">${starDisplay(r.rating)}</span>` : \"\"}\n        </div>\n      </div>`;\n  }).join(\"\") : `<div class=\"empty\"><div class=\"empty-icon\">📖</div><p>${searchQ || filterCat || filterDiff ? \"No recipes match your filters.\" : \"No recipes yet — tap + to add your first.\"}</p></div>`;\n\n  document.getElementById(\"root\").innerHTML = `\n    <div class=\"search-row\">\n      <input class=\"search-input\" type=\"text\" placeholder=\"Search recipes…\" value=\"${esc(searchQ)}\"\n        oninput=\"setSearch(this.value)\" autocomplete=\"off\" />\n    </div>\n    <div class=\"filter-row\">\n      <button class=\"chip${!filterCat && !filterDiff ? \" active\" : \"\"}\" onclick=\"clearFilters()\">All</button>\n      ${catOptions}\n      ${diffChips}\n      <select class=\"sort-select\" onchange=\"setSortBy(this.value)\">\n        <option value=\"title\"${sortBy===\"title\"?\" selected\":\"\"}>A–Z</option>\n        <option value=\"rating\"${sortBy===\"rating\"?\" selected\":\"\"}>Top rated</option>\n        <option value=\"time\"${sortBy===\"time\"?\" selected\":\"\"}>Quickest</option>\n      </select>\n    </div>\n    <div class=\"recipe-grid\">${cards}</div>\n    <button class=\"fab\" onclick=\"openForm()\" title=\"Add recipe\">+</button>`;\n}\n\nfunction renderDetail() {\n  const r = currentRecipe;\n  if (!r) { view = \"list\"; render(); return; }\n  const cat = categories.find(c => c.id === r.category_id);\n  const isUrl = r.source?.startsWith(\"http\");\n\n  document.getElementById(\"root\").innerHTML = `\n    <div class=\"topbar\">\n      <button class=\"topbar-back\" onclick=\"goList()\">←</button>\n      <span class=\"topbar-title\">${esc(r.title)}</span>\n      <div class=\"topbar-actions\">\n        <button class=\"btn btn-ghost\" style=\"padding:7px 12px;font-size:0.85rem\" onclick=\"openEdit('${r.id}')\">Edit</button>\n        <button class=\"btn btn-danger\" style=\"padding:7px 12px;font-size:0.85rem\" onclick=\"doDelete('${r.id}')\">Delete</button>\n      </div>\n    </div>\n\n    <div class=\"detail-meta-row\">\n      <span class=\"badge badge-${r.difficulty}\">${difficultyLabel(r.difficulty)}</span>\n      ${cat ? `<span class=\"badge badge-cat\" style=\"background:${esc(cat.color)}\">${esc(cat.name)}</span>` : \"\"}\n      ${r.total_time_mins ? `<span class=\"meta-text\">⏱ ${formatTime(r.total_time_mins)}</span>` : \"\"}\n      ${r.servings ? `<span class=\"meta-text\">👥 ${r.servings} servings</span>` : \"\"}\n      ${r.rating ? `<span class=\"stars\" title=\"${r.rating}/5 stars\">${starDisplay(r.rating)}</span>` : \"\"}\n    </div>\n\n    ${r.description ? `<p style=\"font-size:0.92rem;color:var(--muted);margin-bottom:8px\">${esc(r.description)}</p>` : \"\"}\n    ${r.source ? `<p><a class=\"source-link\" href=\"${isUrl ? esc(r.source) : \"#\"}\" ${isUrl ? 'target=\"_blank\" rel=\"noopener\"' : \"\"}>${esc(r.source)}</a></p>` : \"\"}\n\n    ${r.ingredients.length ? `\n      <div class=\"detail-section\">\n        <h3>Ingredients</h3>\n        <ul class=\"ingredient-list\">\n          ${r.ingredients.map(i => `<li>${esc(formatIngredient(i))}</li>`).join(\"\")}\n        </ul>\n      </div>` : \"\"}\n\n    ${r.steps.length ? `\n      <div class=\"detail-section\">\n        <h3>Steps</h3>\n        <ol class=\"step-list\">\n          ${r.steps.map(s => `<li><span>${esc(s.instruction)}</span></li>`).join(\"\")}\n        </ol>\n      </div>` : \"\"}\n\n    ${r.notes ? `\n      <div class=\"detail-section\">\n        <h3>Notes</h3>\n        <p class=\"notes-text\">${esc(r.notes)}</p>\n      </div>` : \"\"}\n\n    <div class=\"detail-footer\">\n      ${r.ingredients.length ? `<button class=\"btn btn-amber\" id=\"grocery-btn\" onclick=\"doAddToGrocery()\">🛒 Add to Grocery</button>` : \"\"}\n    </div>`;\n}\n\nfunction renderForm() {\n  const editing = !!editingId;\n  const catOptions = `<option value=\"\">Uncategorized</option>` +\n    categories.map(c => `<option value=\"${esc(c.id)}\"${(editing && currentRecipe?.category_id === c.id) ? \" selected\" : \"\"}>${esc(c.name)}</option>`).join(\"\");\n\n  const ingsHtml = formIngredients.map((ing, i) => `\n    <div class=\"ing-row\">\n      <input class=\"ing-amount\" type=\"text\" placeholder=\"Qty\" value=\"${esc(ing.amount)}\" oninput=\"captureIng(${i},'amount',this.value)\" />\n      <input class=\"ing-unit\" type=\"text\" placeholder=\"Unit\" value=\"${esc(ing.unit)}\" oninput=\"captureIng(${i},'unit',this.value)\" />\n      <input class=\"ing-name\" type=\"text\" placeholder=\"Ingredient\" value=\"${esc(ing.name)}\" oninput=\"captureIng(${i},'name',this.value)\" />\n      <button class=\"row-del\" onclick=\"removeIng(${i})\">✕</button>\n    </div>`).join(\"\");\n\n  const stepsHtml = formSteps.map((s, i) => `\n    <div class=\"step-row\">\n      <textarea placeholder=\"Step ${i + 1}…\" oninput=\"captureStep(${i},this.value)\">${esc(s.instruction)}</textarea>\n      <button class=\"row-del\" onclick=\"removeStep(${i})\">✕</button>\n    </div>`).join(\"\");\n\n  const starsHtml = [1,2,3,4,5].map(n =>\n    `<button class=\"star-btn${formRating >= n ? \" on\" : \"\"}\" onclick=\"setRating(${n})\">★</button>`\n  ).join(\"\");\n\n  document.getElementById(\"root\").innerHTML = `\n    <div class=\"topbar\">\n      <button class=\"topbar-back\" onclick=\"cancelForm()\">←</button>\n      <span class=\"topbar-title\">${editing ? \"Edit Recipe\" : \"New Recipe\"}</span>\n    </div>\n    <div class=\"form-card\">\n      <div class=\"field\">\n        <label>Title *</label>\n        <input id=\"f-title\" type=\"text\" placeholder=\"Recipe title\" value=\"${editing ? esc(currentRecipe?.title ?? \"\") : \"\"}\" />\n      </div>\n      <div class=\"field\">\n        <label>Description</label>\n        <textarea id=\"f-desc\" placeholder=\"A brief description…\">${editing ? esc(currentRecipe?.description ?? \"\") : \"\"}</textarea>\n      </div>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap\">\n        <div class=\"field\" style=\"flex:1;min-width:140px\">\n          <label>Category <button onclick=\"openCats()\" style=\"font-size:0.7rem;color:var(--accent);background:none;border:none;cursor:pointer;font-family:inherit;font-weight:600\">+ Manage</button></label>\n          <select id=\"f-cat\">${catOptions}</select>\n        </div>\n        <div class=\"field\" style=\"flex:1;min-width:120px\">\n          <label>Servings</label>\n          <input id=\"f-servings\" type=\"number\" min=\"1\" value=\"${editing ? (currentRecipe?.servings ?? 4) : 4}\" />\n        </div>\n        <div class=\"field\" style=\"flex:1;min-width:120px\">\n          <label>Total time (min)</label>\n          <input id=\"f-time\" type=\"number\" min=\"1\" placeholder=\"e.g. 45\" value=\"${editing ? (currentRecipe?.total_time_mins ?? \"\") : \"\"}\" />\n        </div>\n      </div>\n      <div class=\"field\">\n        <label>Difficulty</label>\n        <div class=\"difficulty-group\">\n          ${[\"easy\",\"medium\",\"hard\"].map(d =>\n            `<button class=\"diff-btn ${d}${formDifficulty === d ? \" active\" : \"\"}\" onclick=\"setDiff('${d}')\">${difficultyLabel(d)}</button>`\n          ).join(\"\")}\n        </div>\n      </div>\n      <div class=\"field\">\n        <label>Rating</label>\n        <div class=\"stars-input\">${starsHtml}<button class=\"row-del\" onclick=\"setRating(0)\" title=\"Clear rating\" style=\"font-size:0.8rem\">✕</button></div>\n      </div>\n      <div class=\"field\">\n        <label>Source</label>\n        <input id=\"f-source\" type=\"text\" placeholder=\"URL or book name\" value=\"${editing ? esc(currentRecipe?.source ?? \"\") : \"\"}\" />\n      </div>\n      <div class=\"field\">\n        <label>Notes</label>\n        <textarea id=\"f-notes\" placeholder=\"Tips, variations…\">${editing ? esc(currentRecipe?.notes ?? \"\") : \"\"}</textarea>\n      </div>\n\n      <div class=\"field\">\n        <label>Ingredients</label>\n        <div id=\"ing-list\">${ingsHtml}</div>\n        <button class=\"add-row-btn\" onclick=\"addIng()\">+ Add ingredient</button>\n      </div>\n\n      <div class=\"field\">\n        <label>Steps</label>\n        <div id=\"step-list\">${stepsHtml}</div>\n        <button class=\"add-row-btn\" onclick=\"addStep()\">+ Add step</button>\n      </div>\n\n      <div class=\"form-actions\">\n        <button class=\"btn btn-ghost\" onclick=\"cancelForm()\">Cancel</button>\n        <button class=\"btn btn-primary\" onclick=\"doSave()\">Save</button>\n      </div>\n    </div>`;\n\n  document.getElementById(\"f-title\")?.focus();\n}\n\n// ── Window globals ────────────────────────────────────────────────────────────\nwindow.openDetail = async function(id) {\n  currentRecipe = await loadRecipeFull(id);\n  view = \"detail\"; render();\n};\nwindow.goList = function() { view = \"list\"; render(); };\nwindow.openForm = function() {\n  editingId = null; currentRecipe = null;\n  formIngredients = [{ amount: \"\", unit: \"\", name: \"\" }];\n  formSteps = [{ instruction: \"\" }];\n  formDifficulty = \"medium\"; formRating = 0;\n  view = \"form\"; render();\n};\nwindow.openEdit = async function(id) {\n  currentRecipe = await loadRecipeFull(id);\n  editingId = id;\n  formIngredients = currentRecipe.ingredients.length\n    ? currentRecipe.ingredients.map(i => ({ amount: i.amount, unit: i.unit, name: i.name }))\n    : [{ amount: \"\", unit: \"\", name: \"\" }];\n  formSteps = currentRecipe.steps.length\n    ? currentRecipe.steps.map(s => ({ instruction: s.instruction }))\n    : [{ instruction: \"\" }];\n  formDifficulty = currentRecipe.difficulty ?? \"medium\";\n  formRating = currentRecipe.rating ?? 0;\n  view = \"form\"; render();\n};\nwindow.cancelForm = function() { view = editingId ? \"detail\" : \"list\"; render(); };\nwindow.doSave = saveRecipe;\nwindow.doDelete = id => deleteRecipe(id);\nwindow.doAddToGrocery = async function() {\n  const btn = document.getElementById(\"grocery-btn\");\n  if (btn) { btn.disabled = true; btn.textContent = \"Adding…\"; }\n  await addToGrocery(currentRecipe);\n  if (btn) { btn.disabled = false; btn.textContent = \"🛒 Add to Grocery\"; }\n};\nwindow.setFilterCat  = id  => { filterCat  = filterCat  === id  ? \"\" : id;  render(); };\nwindow.setFilterDiff = d   => { filterDiff = filterDiff === d   ? \"\" : d;   render(); };\nwindow.clearFilters  = ()  => { filterCat = \"\"; filterDiff = \"\";             render(); };\nwindow.setSearch     = q   => { searchQ = q;                                  render(); };\nwindow.setSortBy     = s   => { sortBy = s;                                   render(); };\nwindow.setDiff       = d   => { formDifficulty = d;                           render(); };\nwindow.setRating     = n   => { formRating = formRating === n ? 0 : n;       render(); };\nwindow.openCats      = openCategoryModal;\nwindow.captureIng  = (i, field, val) => { formIngredients[i][field] = val; };\nwindow.captureStep = (i, val)        => { formSteps[i].instruction = val; };\nwindow.addIng  = () => { formIngredients.push({ amount: \"\", unit: \"\", name: \"\" }); render(); };\nwindow.removeIng  = i => { removeIngredientRow(i); render(); };\nwindow.addStep = () => { formSteps.push({ instruction: \"\" }); render(); };\nwindow.removeStep = i => { removeStepRow(i); render(); };\n\n// ── Toast ─────────────────────────────────────────────────────────────────────\nlet toastTimer = null;\nfunction showToast(msg, type = \"\") {\n  const el = document.getElementById(\"toast\");\n  el.textContent = msg;\n  el.className = `toast${type ? \" \" + type : \"\"} show`;\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(() => { el.className = \"toast\"; }, 3000);\n}\n\n// ── Init ──────────────────────────────────────────────────────────────────────\n(async () => {\n  if (!DB) {\n    recipes = [\n      { id: \"demo-1\", title: \"Spaghetti Bolognese\", difficulty: \"medium\", servings: 4, total_time_mins: 60, rating: 5, category_id: null },\n      { id: \"demo-2\", title: \"Caesar Salad\",        difficulty: \"easy\",   servings: 2, total_time_mins: 15, rating: 4, category_id: null },\n      { id: \"demo-3\", title: \"Chicken Tikka Masala\", difficulty: \"hard\",  servings: 4, total_time_mins: 90, rating: 5, category_id: null },\n    ];\n  } else {\n    await loadAll();\n  }\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "logic.js": "export function formatIngredient(ing) {\n  return [ing.amount, ing.unit, ing.name].filter(Boolean).join(\" \").trim();\n}\n\nexport function formatTime(mins) {\n  if (!mins) return \"\";\n  if (mins < 60) return `${mins}m`;\n  const h = Math.floor(mins / 60), m = mins % 60;\n  return m ? `${h}h ${m}m` : `${h}h`;\n}\n\nexport function difficultyLabel(d) {\n  return { easy: \"Easy\", medium: \"Medium\", hard: \"Hard\" }[d] ?? d;\n}\n\nexport function difficultyColor(d) {\n  return { easy: \"#059669\", medium: \"#d97706\", hard: \"#dc2626\" }[d] ?? \"#6b7280\";\n}\n\nexport function starDisplay(rating) {\n  if (!rating) return \"\";\n  return \"★\".repeat(rating) + \"☆\".repeat(5 - rating);\n}\n\nexport function sortRecipes(list, sort) {\n  const copy = [...list];\n  if (sort === \"rating\") return copy.sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0) || a.title.localeCompare(b.title));\n  if (sort === \"time\")   return copy.sort((a, b) => (a.total_time_mins ?? 9999) - (b.total_time_mins ?? 9999) || a.title.localeCompare(b.title));\n  return copy.sort((a, b) => a.title.localeCompare(b.title));\n}\n"
  }
}