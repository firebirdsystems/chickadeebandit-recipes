{
  "manifest": {
    "id": "recipes",
    "name": "Recipes",
    "version": "1.0.0",
    "description": "A household recipe book with ingredients, steps, categories, ratings, and difficulty. Add any recipe's ingredients directly to your grocery list.",
    "entrypoint": "index.html",
    "runtime": "static",
    "storage": "db",
    "category": "home",
    "tags": [
      "recipes",
      "food",
      "cooking",
      "ingredients"
    ],
    "exports": [
      "recipes"
    ],
    "data_access": {
      "reads": [
        "family.members"
      ],
      "writes": [
        "app.grocery.pending_items"
      ]
    },
    "permissions": {
      "default_audience": "everyone",
      "requires_approval": false
    },
    "resource_limits": {
      "max_db_bytes": 104857600
    },
    "nav": {
      "label": "Recipes"
    },
    "widget": {
      "label": "Recipes",
      "size": "small"
    },
    "icon": "📖"
  },
  "migrations": [
    {
      "version": 1,
      "sql": "CREATE TABLE IF NOT EXISTS categories (\n  household_id UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id           TEXT NOT NULL,\n  name         TEXT NOT NULL,\n  color        TEXT NOT NULL DEFAULT '#6b7280',\n  created_at   TEXT NOT NULL,\n  PRIMARY KEY (household_id, id)\n);"
    },
    {
      "version": 2,
      "sql": "CREATE TABLE IF NOT EXISTS recipes (\n  household_id      UUID NOT NULL DEFAULT current_setting('app.household_id', true)::uuid,\n  id                TEXT NOT NULL,\n  title             TEXT NOT NULL,\n  description       TEXT NOT NULL DEFAULT '',\n  steps_text        TEXT NOT NULL DEFAULT '',\n  ingredients_text  TEXT NOT NULL DEFAULT '',\n  category_id       TEXT,\n  difficulty        TEXT NOT NULL DEFAULT 'medium',\n  servings          INTEGER NOT NULL DEFAULT 4,\n  total_time_mins   INTEGER,\n  source            TEXT NOT NULL DEFAULT '',\n  rating            INTEGER,\n  notes             TEXT NOT NULL DEFAULT '',\n  is_favorite       INTEGER NOT NULL DEFAULT 0,\n  created_by_id     TEXT NOT NULL,\n  created_by_name   TEXT NOT NULL,\n  created_at        TEXT NOT NULL,\n  updated_at        TEXT NOT NULL,\n  PRIMARY KEY (household_id, id)\n);"
    }
  ],
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Recipes</title>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    :root {\n      --bg:           var(--hub-bg, #f9fafb);\n      --card:         var(--hub-surface, #ffffff);\n      --border:       var(--hub-border, #e5e7eb);\n      --text:         var(--hub-text, #111827);\n      --muted:        var(--hub-text-muted, #6b7280);\n      --accent:       var(--hub-primary, #111827);\n      --accent-hover: var(--hub-primary-hover, #374151);\n      --accent-fg:    var(--hub-primary-fg, #fff);\n      --radius:       var(--hub-radius, 0.5rem);\n      --shadow:       0 1px 3px rgba(0,0,0,.07);\n      --green: #059669; --amber: #d97706; --red: #dc2626;\n      --amber-bg: #fffbeb; --amber-border: #fcd34d;\n      --green-bg: #f0fdf4; --red-bg: #fef2f2;\n    }\n\n    html, body { height: 100%; overflow: hidden; }\n    body {\n      font-family: var(--hub-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif);\n      background: var(--bg); color: var(--text);\n      font-size: var(--hub-font-size, 15px); line-height: 1.5;\n    }\n\n    /* ── Two-pane layout ── */\n    .layout { display: flex; height: 100%; overflow: hidden; }\n\n    /* ── Left nav ── */\n    .nav-pane {\n      width: 200px; flex-shrink: 0;\n      background: var(--card);\n      border-right: 1px solid var(--border);\n      overflow-y: auto;\n      display: flex; flex-direction: column;\n    }\n    .nav-item {\n      display: block; width: 100%; text-align: left; white-space: nowrap;\n      overflow: hidden; text-overflow: ellipsis;\n      padding: 8px 16px; border: none; background: none;\n      font-size: 0.875rem; font-family: inherit; color: var(--text);\n      cursor: pointer; transition: background .12s;\n    }\n    .nav-item:hover { background: var(--border); }\n    .nav-item.active { background: var(--accent); color: var(--accent-fg); font-weight: 600; }\n    .nav-item.active:hover { background: var(--accent-hover); }\n    .nav-section {\n      padding: 14px 16px 4px;\n      font-size: 0.68rem; font-weight: 700; letter-spacing: .08em;\n      text-transform: uppercase; color: var(--muted);\n    }\n    .nav-section-row {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 14px 8px 4px 16px;\n      font-size: 0.68rem; font-weight: 700; letter-spacing: .08em;\n      text-transform: uppercase; color: var(--muted);\n    }\n    .nav-add-btn {\n      background: none; border: none; color: var(--muted); font-size: 1.1rem; line-height: 1;\n      cursor: pointer; width: 26px; height: 26px; border-radius: 5px; flex-shrink: 0;\n      display: flex; align-items: center; justify-content: center; transition: background .12s, color .12s;\n    }\n    .nav-add-btn:hover { background: var(--border); color: var(--accent); }\n    .cat-inline-form { padding: 6px 10px 10px; border-bottom: 1px solid var(--border); }\n    .cat-inline-input {\n      display: block; width: 100%; padding: 5px 8px; font-size: 0.83rem;\n      border: 1.5px solid var(--border); border-radius: 6px;\n      font-family: inherit; color: var(--text); background: var(--card); outline: none;\n    }\n    .cat-inline-input:focus { border-color: var(--accent); }\n    .cat-inline-row { display: flex; gap: 5px; align-items: center; margin-top: 5px; }\n    .nav-cat-row { display: flex; align-items: center; }\n    .nav-cat-row .nav-item { flex: 1; min-width: 0; }\n    .nav-cat-del {\n      background: none; border: none; color: var(--muted); font-size: 0.9rem; line-height: 1;\n      cursor: pointer; padding: 0 8px; opacity: 0; flex-shrink: 0; transition: opacity .12s, color .12s;\n    }\n    .nav-cat-row:hover .nav-cat-del { opacity: 1; }\n    .nav-cat-del:hover { color: var(--red); }\n    .cat-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; flex-shrink: 0; }\n    .nav-divider { height: 1px; background: var(--border); margin: 6px 0; }\n\n    /* ── Right content pane ── */\n    .content-pane { flex: 1; min-width: 0; overflow-y: auto; padding: 16px; }\n\n    /* ── Full-screen pane (form) ── */\n    .full-pane { flex: 1; overflow-y: auto; padding: 16px; }\n    .full-pane-inner { max-width: 640px; margin: 0 auto; }\n\n    /* ── Search row ── */\n    .search-row { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; }\n    .search-input {\n      flex: 1; border: 1.5px solid var(--border); border-radius: 8px;\n      padding: 8px 12px; font-size: 0.9rem; background: var(--card);\n      outline: none; font-family: inherit; color: var(--text);\n    }\n    .search-input:focus { border-color: var(--accent); }\n    select.sort-select {\n      width: auto; border: 1.5px solid var(--border); border-radius: 8px; padding: 6px 8px;\n      font-size: 0.8rem; background: var(--card); color: var(--text);\n      outline: none; font-family: inherit; cursor: pointer; flex-shrink: 0;\n    }\n\n    /* ── Recipe cards ── */\n    .recipe-grid { display: flex; flex-direction: column; gap: 8px; }\n    .recipe-card {\n      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);\n      padding: 12px 14px; cursor: pointer; transition: border-color .15s, box-shadow .15s;\n      box-shadow: var(--shadow); display: flex; align-items: flex-start; gap: 10px;\n    }\n    .recipe-card:hover { border-color: var(--accent); box-shadow: 0 2px 8px rgba(0,0,0,.1); }\n    .recipe-card-body { flex: 1; min-width: 0; }\n    .recipe-card-title { font-weight: 700; font-size: 0.95rem; margin-bottom: 4px; }\n    .recipe-card-meta { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }\n    .badge {\n      display: inline-block; padding: 2px 7px; border-radius: 999px;\n      font-size: 0.7rem; font-weight: 700; color: white;\n    }\n    .badge-easy   { background: var(--green); }\n    .badge-medium { background: var(--amber); }\n    .badge-hard   { background: var(--red); }\n    .badge-cat    { background: #6366f1; }\n    .meta-text { font-size: 0.78rem; color: var(--muted); }\n    .stars { color: #f59e0b; font-size: 0.82rem; letter-spacing: -.05em; }\n\n    /* ── Heart button ── */\n    .heart-btn {\n      background: none; border: none; font-size: 1.15rem; line-height: 1;\n      cursor: pointer; padding: 4px 3px; border-radius: 6px; flex-shrink: 0;\n      color: #d1d5db; transition: color .12s, background .12s;\n    }\n    .heart-btn:hover { color: #f43f5e; background: #fff1f2; }\n    .heart-btn.on { color: #f43f5e; }\n\n    /* ── FAB ── */\n    .fab {\n      position: fixed; bottom: 24px; right: 24px;\n      width: 52px; height: 52px; border-radius: 50%;\n      background: var(--accent); color: var(--accent-fg);\n      border: none; font-size: 1.5rem; cursor: pointer;\n      box-shadow: 0 4px 12px rgba(0,0,0,.2); transition: background .15s, transform .1s;\n      display: flex; align-items: center; justify-content: center; z-index: 50;\n    }\n    .fab:hover { background: var(--accent-hover); transform: scale(1.05); }\n\n    /* ── Detail view ── */\n    .detail-topbar {\n      display: flex; align-items: center; gap: 8px; margin-bottom: 14px; flex-wrap: wrap;\n    }\n    .detail-title { font-size: 1.3rem; font-weight: 700; flex: 1; }\n    .detail-actions { display: flex; gap: 6px; }\n    .detail-meta-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 10px 0 16px; }\n    .detail-section { margin-top: 20px; }\n    .detail-section h3 {\n      font-size: 0.72rem; font-weight: 700; color: var(--muted);\n      text-transform: uppercase; letter-spacing: .08em; margin-bottom: 10px;\n    }\n    .ingredient-list { list-style: none; }\n    .ingredient-list li {\n      padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 0.92rem;\n    }\n    .ingredient-list li:last-child { border-bottom: none; }\n    .source-link { font-size: 0.85rem; color: #2563eb; word-break: break-all; }\n    .notes-text { font-size: 0.9rem; color: var(--muted); font-style: italic; white-space: pre-wrap; }\n    .steps-text { font-size: 0.92rem; white-space: pre-wrap; line-height: 1.65; }\n    .detail-footer {\n      display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px;\n      padding-top: 16px; border-top: 1px solid var(--border);\n    }\n\n    /* ── Buttons ── */\n    .btn {\n      padding: 8px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;\n      cursor: pointer; border: none; transition: all .15s; font-family: inherit;\n    }\n    .btn-primary { background: var(--accent); color: var(--accent-fg); }\n    .btn-primary:hover { background: var(--accent-hover); }\n    .btn-primary:disabled { opacity: .45; cursor: default; }\n    .btn-amber { background: var(--amber-bg); color: #92400e; border: 1.5px solid var(--amber-border); }\n    .btn-amber:hover { background: #fef3c7; }\n    .btn-ghost { background: none; color: var(--muted); border: 1.5px solid var(--border); }\n    .btn-ghost:hover { border-color: var(--text); color: var(--text); }\n    .btn-danger { background: var(--red-bg); color: var(--red); border: 1.5px solid #fecaca; }\n    .btn-danger:hover { background: #fee2e2; }\n    .back-btn {\n      background: none; border: none; color: var(--muted); font-size: 1.1rem;\n      cursor: pointer; padding: 4px 8px; border-radius: 6px; line-height: 1; display: none;\n    }\n    .back-btn:hover { background: var(--border); color: var(--text); }\n\n    /* ── Form ── */\n    .form-topbar {\n      display: flex; align-items: center; gap: 8px; margin-bottom: 14px;\n    }\n    .form-back {\n      background: none; border: none; color: var(--muted); font-size: 1.1rem;\n      cursor: pointer; padding: 4px 6px; border-radius: 6px; line-height: 1;\n    }\n    .form-back:hover { background: var(--border); color: var(--text); }\n    .form-title { font-size: 1.1rem; font-weight: 700; }\n    .form-card {\n      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);\n      padding: 20px; box-shadow: var(--shadow);\n    }\n    .field { margin-bottom: 14px; }\n    label {\n      display: block; font-size: 0.78rem; font-weight: 600; color: var(--muted);\n      margin-bottom: 5px; text-transform: uppercase; letter-spacing: .04em;\n    }\n    input[type=text], input[type=number], textarea, select {\n      width: 100%; border: 1.5px solid var(--border); border-radius: 8px;\n      padding: 8px 12px; font-size: 0.92rem; font-family: inherit; color: var(--text);\n      background: var(--card); outline: none; transition: border-color .15s;\n    }\n    input[type=text]:focus, input[type=number]:focus, textarea:focus, select:focus {\n      border-color: var(--accent);\n    }\n    textarea { resize: vertical; min-height: 72px; }\n    textarea.tall { min-height: 160px; }\n    .difficulty-group { display: flex; gap: 8px; }\n    .diff-btn {\n      flex: 1; padding: 7px; border-radius: 8px; border: 1.5px solid var(--border);\n      background: var(--card); font-size: 0.85rem; font-weight: 600; cursor: pointer;\n      transition: all .15s; font-family: inherit; color: var(--muted);\n    }\n    .diff-btn.easy.active  { background: var(--green-bg); border-color: var(--green); color: var(--green); }\n    .diff-btn.medium.active { background: var(--amber-bg); border-color: var(--amber); color: var(--amber); }\n    .diff-btn.hard.active  { background: var(--red-bg);   border-color: var(--red);   color: var(--red); }\n    .stars-input { display: flex; gap: 4px; }\n    .star-btn { background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #d1d5db; padding: 0 2px; transition: color .1s; }\n    .star-btn.on { color: #f59e0b; }\n    .row-del { background: none; border: none; color: var(--muted); font-size: 1.1rem; cursor: pointer; padding: 8px 6px; border-radius: 6px; flex-shrink: 0; }\n    .row-del:hover { background: var(--red-bg); color: var(--red); }\n    .form-actions { display: flex; gap: 8px; margin-top: 20px; justify-content: flex-end; }\n\n    /* ── Toast ── */\n    .toast {\n      position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);\n      background: #1f2937; color: #f9fafb; padding: 10px 18px; border-radius: 8px;\n      font-size: 0.875rem; font-weight: 500; box-shadow: 0 4px 12px rgba(0,0,0,.3);\n      z-index: 200; pointer-events: none; opacity: 0; transition: opacity .2s;\n      white-space: nowrap;\n    }\n    .toast.show { opacity: 1; }\n    .toast.error { background: #7f1d1d; }\n\n    /* ── Modal ── */\n    .modal-backdrop {\n      position: fixed; inset: 0; background: rgba(0,0,0,.4);\n      display: flex; align-items: center; justify-content: center;\n      padding: 16px; z-index: 100;\n    }\n    .modal {\n      background: var(--card); border-radius: 12px; padding: 20px;\n      width: 100%; max-width: 380px; box-shadow: 0 8px 32px rgba(0,0,0,.2);\n    }\n    .modal h3 { font-size: 1rem; font-weight: 700; margin-bottom: 14px; }\n    .modal-actions { display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end; }\n\n    /* ── Empty / loading ── */\n    .empty { text-align: center; padding: 48px 16px; color: var(--muted); }\n    .empty-icon { font-size: 3rem; margin-bottom: 10px; }\n    .loading { text-align: center; padding: 48px; color: var(--muted); }\n\n    /* ── Mobile ── */\n    @media (max-width: 580px) {\n      .layout { flex-direction: column; }\n      .nav-pane {\n        width: 100%; height: auto; flex-direction: row; flex-shrink: 0;\n        overflow-x: auto; overflow-y: hidden;\n        border-right: none; border-bottom: 1px solid var(--border);\n        padding: 8px; gap: 5px;\n      }\n      .nav-section, .nav-divider { display: none; }\n      .nav-item {\n        width: auto; flex-shrink: 0; white-space: nowrap;\n        padding: 5px 12px; border-radius: 999px;\n        border: 1.5px solid var(--border);\n        font-size: 0.82rem;\n      }\n      .nav-item.active {\n        background: var(--accent); color: var(--accent-fg);\n        border-color: var(--accent); font-weight: 600;\n      }\n      .nav-item:hover { background: var(--border); }\n      .nav-item.active:hover { background: var(--accent-hover); }\n      .layout.detail-mode .nav-pane { display: none; }\n      .back-btn { display: block; }\n      .fab { bottom: 16px; right: 16px; }\n      .nav-section-row, .cat-inline-form { display: none; }\n      .nav-cat-del { opacity: 1; }\n    }\n  </style>\n  <base href=\"/run/recipes/\">\n</head>\n<body>\n<div id=\"layout\" class=\"layout\"></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script type=\"module\">\nimport { esc, hubConfirm, crossWrite } from \"/hub-sdk.js\";\nimport { formatTime, difficultyLabel, starDisplay, sortRecipes } from \"./logic.js\";\n\nconst DB    = window.__DB_URL         ?? \"\";\nconst STORE = window.__STORE_URL      ?? \"\";\nconst ME    = window.__CURRENT_MEMBER ?? null;\n\n// ── State ─────────────────────────────────────────────────────────────────────\nlet view      = \"browse\"; // \"browse\" | \"form\"\nlet rightView = \"list\";   // \"list\"   | \"detail\"  (only when view=\"browse\")\n\nlet recipes = [], categories = [];\nlet currentRecipe = null;\nlet editingId     = null;\nlet navFilter     = \"all\"; // \"all\" | \"top_rated\" | \"favorites\" | \"cat:{id}\" | \"uncategorized\"\nlet searchQ       = \"\";\nlet sortBy        = \"title\"; // \"title\" | \"time\"\n\nlet formDifficulty = \"medium\";\nlet formRating     = 0;\nlet showCatForm    = false;\nlet formFields     = { title:\"\", description:\"\", category_id:\"\", servings:\"4\", total_time_mins:\"\", source:\"\", ings:\"\", steps:\"\", notes:\"\" };\n\nfunction captureFormFields() {\n  if (view !== \"form\") return;\n  formFields = {\n    title:         document.getElementById(\"f-title\")?.value    ?? formFields.title,\n    description:   document.getElementById(\"f-desc\")?.value     ?? formFields.description,\n    category_id:   document.getElementById(\"f-cat\")?.value      ?? formFields.category_id,\n    servings:      document.getElementById(\"f-servings\")?.value ?? formFields.servings,\n    total_time_mins: document.getElementById(\"f-time\")?.value   ?? formFields.total_time_mins,\n    source:        document.getElementById(\"f-source\")?.value   ?? formFields.source,\n    ings:          document.getElementById(\"f-ings\")?.value     ?? formFields.ings,\n    steps:         document.getElementById(\"f-steps\")?.value    ?? formFields.steps,\n    notes:         document.getElementById(\"f-notes\")?.value    ?? formFields.notes,\n  };\n}\n\n// ── DB ────────────────────────────────────────────────────────────────────────\nasync function db(sql, params = []) {\n  if (!DB) return { rows: [] };\n  const res = await fetch(DB, {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ sql, params }),\n  });\n  const json = await res.json();\n  if (json.error) throw new Error(json.error);\n  return json;\n}\n\n// ── Data loading ──────────────────────────────────────────────────────────────\nasync function loadAll() {\n  const [rRes, cRes] = await Promise.all([\n    db(`SELECT * FROM recipes ORDER BY title`),\n    db(`SELECT * FROM categories ORDER BY name`),\n  ]);\n  recipes    = rRes.rows;\n  categories = cRes.rows;\n}\n\nasync function loadRecipeFull(id) {\n  const { rows } = await db(`SELECT * FROM recipes WHERE id = ?`, [id]);\n  return rows[0] ?? null;\n}\n\n// ── Filtered recipe list ──────────────────────────────────────────────────────\nfunction getFiltered() {\n  let list = [...recipes];\n\n  if      (navFilter === \"top_rated\")    list = list.filter(r => r.rating);\n  else if (navFilter === \"favorites\")    list = list.filter(r => !!r.is_favorite);\n  else if (navFilter === \"uncategorized\") list = list.filter(r => !r.category_id);\n  else if (navFilter.startsWith(\"cat:\")) {\n    const catId = navFilter.slice(4);\n    list = list.filter(r => r.category_id === catId);\n  }\n\n  if (searchQ) {\n    const q = searchQ.toLowerCase();\n    list = list.filter(r => r.title.toLowerCase().includes(q));\n  }\n\n  if (navFilter === \"top_rated\") {\n    list.sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0) || a.title.localeCompare(b.title));\n  } else {\n    list = sortRecipes(list, sortBy);\n  }\n\n  return list;\n}\n\n// ── KV export sync ────────────────────────────────────────────────────────────\nasync function syncExport() {\n  if (!STORE) return;\n  try {\n    const { rows } = await db(`SELECT * FROM recipes ORDER BY title`);\n    const exported = rows.map(r => ({\n      id: r.id, title: r.title, category_id: r.category_id,\n      difficulty: r.difficulty, servings: r.servings,\n      total_time_mins: r.total_time_mins, rating: r.rating,\n      ingredients_text: r.ingredients_text ?? \"\",\n    }));\n    await fetch(STORE, {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ key: \"recipes\", value: JSON.stringify(exported) }),\n    });\n  } catch { /* non-fatal */ }\n}\n\n// ── Grocery integration ───────────────────────────────────────────────────────\nasync function addToGrocery(recipe) {\n  const items = (recipe.ingredients_text ?? \"\").split(\"\\n\").map(s => s.trim()).filter(Boolean);\n  if (!items.length) { showToast(\"No ingredients to add\", \"error\"); return; }\n  const ops = items.map(name => ({\n    op: \"array_append\", path: \"items\",\n    value: { name, addedBy: recipe.title },\n  }));\n  try {\n    await crossWrite(\"grocery\", \"pending_items\", ops);\n    showToast(`${items.length} item${items.length !== 1 ? \"s\" : \"\"} added to grocery list`);\n  } catch {\n    showToast(\"Grocery app not available\", \"error\");\n  }\n}\n\n// ── Category CRUD ─────────────────────────────────────────────────────────────\nwindow.toggleCatForm = function() {\n  showCatForm = !showCatForm;\n  render();\n  if (showCatForm) setTimeout(() => document.getElementById(\"new-cat-name\")?.focus(), 0);\n};\n\nwindow.addCatInline = async function() {\n  const nameEl  = document.getElementById(\"new-cat-name\");\n  const colorEl = document.getElementById(\"new-cat-color\");\n  const name = nameEl?.value.trim();\n  if (!name) { nameEl?.focus(); return; }\n  await db(`INSERT INTO categories (id, name, color, created_at) VALUES (?, ?, ?, ?)`,\n    [crypto.randomUUID(), name, colorEl?.value ?? \"#6366f1\", new Date().toISOString()]);\n  await loadAll();\n  showCatForm = false;\n  render();\n  showToast(`\"${name}\" added`);\n};\n\nwindow.deleteCatInline = async function(id, name) {\n  if (!await hubConfirm({ message: `Delete \"${name}\"?`, confirmLabel: \"Delete\", destructive: true })) return;\n  await db(`DELETE FROM categories WHERE id = ?`, [id]);\n  await db(`UPDATE recipes SET category_id = NULL WHERE category_id = ?`, [id]);\n  if (navFilter === \"cat:\" + id) navFilter = \"all\";\n  await loadAll();\n  render();\n};\n\n// ── Favorite toggle ───────────────────────────────────────────────────────────\nasync function toggleFavorite(id, currentVal) {\n  const newVal = currentVal ? 0 : 1;\n  await db(`UPDATE recipes SET is_favorite = ? WHERE id = ?`, [newVal, id]);\n  const r = recipes.find(r => r.id === id);\n  if (r) r.is_favorite = newVal;\n  if (currentRecipe?.id === id) currentRecipe.is_favorite = newVal;\n  render();\n}\n\n// ── Recipe CRUD ───────────────────────────────────────────────────────────────\nasync function saveRecipe() {\n  const title = document.getElementById(\"f-title\")?.value.trim();\n  if (!title) { document.getElementById(\"f-title\")?.focus(); return; }\n\n  const btn = document.querySelector(\".form-actions .btn-primary\");\n  if (btn) { btn.disabled = true; btn.textContent = \"Saving…\"; }\n\n  const now = new Date().toISOString();\n\n  try {\n    const data = {\n      title,\n      description:      document.getElementById(\"f-desc\")?.value.trim()   ?? \"\",\n      category_id:      document.getElementById(\"f-cat\")?.value            || null,\n      difficulty:       formDifficulty,\n      servings:         parseInt(document.getElementById(\"f-servings\")?.value) || 4,\n      total_time_mins:  parseInt(document.getElementById(\"f-time\")?.value)     || null,\n      source:           document.getElementById(\"f-source\")?.value.trim()  ?? \"\",\n      rating:           formRating || null,\n      ingredients_text: document.getElementById(\"f-ings\")?.value           ?? \"\",\n      steps_text:       document.getElementById(\"f-steps\")?.value          ?? \"\",\n      notes:            document.getElementById(\"f-notes\")?.value.trim()   ?? \"\",\n    };\n\n    if (editingId) {\n      await db(\n        `UPDATE recipes SET title=?,description=?,category_id=?,difficulty=?,servings=?,total_time_mins=?,source=?,rating=?,ingredients_text=?,steps_text=?,notes=?,updated_at=? WHERE id=?`,\n        [data.title, data.description, data.category_id, data.difficulty, data.servings,\n         data.total_time_mins, data.source, data.rating, data.ingredients_text,\n         data.steps_text, data.notes, now, editingId]);\n    } else {\n      const id     = crypto.randomUUID();\n      const who    = ME?.id   ?? \"demo\";\n      const whoName = ME?.name ?? \"Demo\";\n      await db(\n        `INSERT INTO recipes (id,title,description,category_id,difficulty,servings,total_time_mins,source,rating,ingredients_text,steps_text,notes,is_favorite,created_by_id,created_by_name,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,0,?,?,?,?)`,\n        [id, data.title, data.description, data.category_id, data.difficulty,\n         data.servings, data.total_time_mins, data.source, data.rating,\n         data.ingredients_text, data.steps_text, data.notes, who, whoName, now, now]);\n      editingId = id;\n    }\n\n    await Promise.all([loadAll(), syncExport()]);\n    currentRecipe = await loadRecipeFull(editingId);\n    view = \"browse\"; rightView = \"detail\";\n    render();\n  } catch {\n    showToast(\"Save failed — try again\", \"error\");\n    if (btn) { btn.disabled = false; btn.textContent = \"Save\"; }\n  }\n}\n\nasync function deleteRecipe(id) {\n  if (!await hubConfirm({ message: \"Delete this recipe?\", confirmLabel: \"Delete\", destructive: true })) return;\n  await db(`DELETE FROM recipes WHERE id = ?`, [id]);\n  await Promise.all([loadAll(), syncExport()]);\n  currentRecipe = null;\n  rightView = \"list\";\n  render();\n}\n\n// ── HTML builders ─────────────────────────────────────────────────────────────\nfunction navHtml() {\n  function item(id, label) {\n    return `<button class=\"nav-item${navFilter === id ? \" active\" : \"\"}\" onclick=\"setNav('${id}')\">${esc(label)}</button>`;\n  }\n  const catItems = categories.map(c => `\n    <div class=\"nav-cat-row\">\n      <button class=\"nav-item${navFilter === \"cat:\" + c.id ? \" active\" : \"\"}\" onclick=\"setNav('cat:${esc(c.id)}')\" title=\"${esc(c.name)}\">\n        <span class=\"cat-dot\" style=\"background:${esc(c.color)}\"></span>${esc(c.name)}\n      </button>\n      <button class=\"nav-cat-del\" onclick=\"deleteCatInline('${esc(c.id)}','${esc(c.name)}')\" title=\"Delete\">×</button>\n    </div>`).join(\"\");\n\n  const catForm = showCatForm ? `\n    <div class=\"cat-inline-form\">\n      <input id=\"new-cat-name\" class=\"cat-inline-input\" type=\"text\" placeholder=\"Category name\"\n        onkeydown=\"if(event.key==='Enter')addCatInline()\" />\n      <div class=\"cat-inline-row\">\n        <input id=\"new-cat-color\" type=\"color\" value=\"#6366f1\"\n          style=\"width:30px;height:28px;border:1px solid var(--border);border-radius:5px;cursor:pointer;flex-shrink:0;padding:1px\" />\n        <button onclick=\"addCatInline()\" class=\"btn btn-primary\" style=\"flex:1;padding:5px 10px;font-size:0.8rem\">Add</button>\n        <button onclick=\"toggleCatForm()\" class=\"btn btn-ghost\" style=\"padding:5px 9px;font-size:0.85rem\">✕</button>\n      </div>\n    </div>` : \"\";\n\n  return `\n    ${item(\"all\",       \"All Recipes\")}\n    ${item(\"top_rated\", \"Top Rated\")}\n    ${item(\"favorites\", \"Favorites\")}\n    <div class=\"nav-divider\"></div>\n    <div class=\"nav-section-row\">Categories <button class=\"nav-add-btn\" onclick=\"toggleCatForm()\" title=\"Add category\">+</button></div>\n    ${catForm}\n    ${catItems}\n    ${item(\"uncategorized\", \"Uncategorized\")}\n  `;\n}\n\nfunction listHtml() {\n  const filtered = getFiltered();\n\n  const showSort = navFilter !== \"top_rated\";\n  const sortSelect = showSort ? `\n    <select class=\"sort-select\" style=\"width:auto\" onchange=\"setSortBy(this.value)\">\n      <option value=\"title\"${sortBy === \"title\" ? \" selected\" : \"\"}>A–Z</option>\n      <option value=\"time\"${sortBy  === \"time\"  ? \" selected\" : \"\"}>Quickest</option>\n    </select>` : \"\";\n\n  const cards = filtered.length ? filtered.map(r => {\n    const cat = categories.find(c => c.id === r.category_id);\n    const fav = !!r.is_favorite;\n    return `\n      <div class=\"recipe-card\" onclick=\"openDetail('${r.id}')\">\n        <div class=\"recipe-card-body\">\n          <div class=\"recipe-card-title\">${esc(r.title)}</div>\n          <div class=\"recipe-card-meta\">\n            <span class=\"badge badge-${r.difficulty}\">${difficultyLabel(r.difficulty)}</span>\n            ${cat ? `<span class=\"badge badge-cat\" style=\"background:${esc(cat.color)}\">${esc(cat.name)}</span>` : \"\"}\n            ${r.total_time_mins ? `<span class=\"meta-text\">⏱ ${formatTime(r.total_time_mins)}</span>` : \"\"}\n            ${r.servings        ? `<span class=\"meta-text\">👥 ${r.servings}</span>` : \"\"}\n            ${r.rating          ? `<span class=\"stars\">${starDisplay(r.rating)}</span>` : \"\"}\n          </div>\n        </div>\n        <button class=\"heart-btn${fav ? \" on\" : \"\"}\" title=\"${fav ? \"Remove from favorites\" : \"Add to favorites\"}\"\n          onclick=\"event.stopPropagation();doToggleFav('${r.id}',${fav ? 1 : 0})\">♥</button>\n      </div>`;\n  }).join(\"\") : `\n    <div class=\"empty\">\n      <div class=\"empty-icon\">📖</div>\n      <p>${searchQ ? \"No recipes match your search.\" : navFilter === \"favorites\" ? \"No favorites yet — click ♥ on a recipe.\" : \"No recipes here yet.\"}</p>\n    </div>`;\n\n  return `\n    <div class=\"search-row\">\n      <input class=\"search-input\" type=\"text\" placeholder=\"Search recipes…\"\n        value=\"${esc(searchQ)}\" oninput=\"setSearch(this.value)\" autocomplete=\"off\" />\n      ${sortSelect}\n    </div>\n    <div class=\"recipe-grid\">${cards}</div>\n    <button class=\"fab\" onclick=\"openForm()\" title=\"Add recipe\">+</button>`;\n}\n\nfunction detailHtml() {\n  const r = currentRecipe;\n  if (!r) return \"\";\n  const cat   = categories.find(c => c.id === r.category_id);\n  const isUrl = r.source?.startsWith(\"http\");\n  const fav   = !!r.is_favorite;\n  const ingredientLines = (r.ingredients_text ?? \"\").split(\"\\n\").map(s => s.trim()).filter(Boolean);\n  const hasIngredients  = ingredientLines.length > 0;\n  const hasSteps        = (r.steps_text ?? \"\").trim().length > 0;\n\n  return `\n    <div class=\"detail-topbar\">\n      <button class=\"back-btn\" onclick=\"goList()\">←</button>\n      <span class=\"detail-title\">${esc(r.title)}</span>\n      <div class=\"detail-actions\">\n        <button class=\"heart-btn${fav ? \" on\" : \"\"}\" title=\"${fav ? \"Remove from favorites\" : \"Add to favorites\"}\"\n          style=\"font-size:1.3rem;padding:6px 5px\"\n          onclick=\"doToggleFav('${r.id}',${fav ? 1 : 0})\">♥</button>\n        <button class=\"btn btn-ghost\" onclick=\"openEdit('${r.id}')\">Edit</button>\n        <button class=\"btn btn-danger\" onclick=\"doDelete('${r.id}')\">Delete</button>\n      </div>\n    </div>\n\n    <div class=\"detail-meta-row\">\n      <span class=\"badge badge-${r.difficulty}\">${difficultyLabel(r.difficulty)}</span>\n      ${cat ? `<span class=\"badge badge-cat\" style=\"background:${esc(cat.color)}\">${esc(cat.name)}</span>` : \"\"}\n      ${r.total_time_mins ? `<span class=\"meta-text\">⏱ ${formatTime(r.total_time_mins)}</span>` : \"\"}\n      ${r.servings        ? `<span class=\"meta-text\">👥 ${r.servings} servings</span>` : \"\"}\n      ${r.rating          ? `<span class=\"stars\" title=\"${r.rating}/5 stars\">${starDisplay(r.rating)}</span>` : \"\"}\n    </div>\n\n    ${r.description ? `<p style=\"font-size:0.92rem;color:var(--muted);margin-bottom:8px\">${esc(r.description)}</p>` : \"\"}\n    ${r.source      ? `<p><a class=\"source-link\" href=\"${isUrl ? esc(r.source) : \"#\"}\" ${isUrl ? 'target=\"_blank\" rel=\"noopener\"' : \"\"}>${esc(r.source)}</a></p>` : \"\"}\n\n    ${hasIngredients ? `\n      <div class=\"detail-section\">\n        <h3>Ingredients</h3>\n        <ul class=\"ingredient-list\">\n          ${ingredientLines.map(line => `<li>${esc(line)}</li>`).join(\"\")}\n        </ul>\n      </div>` : \"\"}\n\n    ${hasSteps ? `\n      <div class=\"detail-section\">\n        <h3>Steps</h3>\n        <p class=\"steps-text\">${esc(r.steps_text)}</p>\n      </div>` : \"\"}\n\n    ${r.notes ? `\n      <div class=\"detail-section\">\n        <h3>Notes</h3>\n        <p class=\"notes-text\">${esc(r.notes)}</p>\n      </div>` : \"\"}\n\n    <div class=\"detail-footer\">\n      ${hasIngredients ? `<button class=\"btn btn-amber\" id=\"grocery-btn\" onclick=\"doAddToGrocery()\">🛒 Add to Grocery</button>` : \"\"}\n    </div>`;\n}\n\nfunction formHtml() {\n  const editing    = !!editingId;\n  const catOptions = `<option value=\"\">Uncategorized</option>` +\n    categories.map(c =>\n      `<option value=\"${esc(c.id)}\"${formFields.category_id === c.id ? \" selected\" : \"\"}>${esc(c.name)}</option>`\n    ).join(\"\");\n\n  const starsHtml = [1,2,3,4,5].map(n =>\n    `<button class=\"star-btn${formRating >= n ? \" on\" : \"\"}\" onclick=\"setRating(${n})\">★</button>`\n  ).join(\"\");\n\n  return `\n    <div class=\"form-topbar\">\n      <button class=\"form-back\" onclick=\"cancelForm()\">←</button>\n      <span class=\"form-title\">${editing ? \"Edit Recipe\" : \"New Recipe\"}</span>\n    </div>\n    <div class=\"form-card\">\n      <div class=\"field\">\n        <label>Title *</label>\n        <input id=\"f-title\" type=\"text\" placeholder=\"Recipe title\" value=\"${esc(formFields.title)}\" />\n      </div>\n      <div class=\"field\">\n        <label>Description</label>\n        <textarea id=\"f-desc\" placeholder=\"A brief description…\">${esc(formFields.description)}</textarea>\n      </div>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap\">\n        <div class=\"field\" style=\"flex:1;min-width:140px\">\n          <label>Category</label>\n          <select id=\"f-cat\">${catOptions}</select>\n        </div>\n        <div class=\"field\" style=\"flex:1;min-width:110px\">\n          <label>Servings</label>\n          <input id=\"f-servings\" type=\"number\" min=\"1\" value=\"${esc(formFields.servings)}\" />\n        </div>\n        <div class=\"field\" style=\"flex:1;min-width:110px\">\n          <label>Time (min)</label>\n          <input id=\"f-time\" type=\"number\" min=\"1\" placeholder=\"e.g. 45\" value=\"${esc(formFields.total_time_mins)}\" />\n        </div>\n      </div>\n      <div class=\"field\">\n        <label>Difficulty</label>\n        <div class=\"difficulty-group\">\n          ${[\"easy\",\"medium\",\"hard\"].map(d =>\n            `<button class=\"diff-btn ${d}${formDifficulty === d ? \" active\" : \"\"}\" onclick=\"setDiff('${d}')\">${difficultyLabel(d)}</button>`\n          ).join(\"\")}\n        </div>\n      </div>\n      <div class=\"field\">\n        <label>Rating</label>\n        <div class=\"stars-input\">\n          ${starsHtml}\n          <button class=\"row-del\" onclick=\"setRating(0)\" title=\"Clear rating\" style=\"font-size:0.8rem\">✕</button>\n        </div>\n      </div>\n      <div class=\"field\">\n        <label>Source</label>\n        <input id=\"f-source\" type=\"text\" placeholder=\"URL or book name\" value=\"${esc(formFields.source)}\" />\n      </div>\n      <div class=\"field\">\n        <label>Ingredients — one per line</label>\n        <textarea id=\"f-ings\" class=\"tall\"\n          placeholder=\"2 cups flour&#10;1 tsp salt&#10;3 eggs\">${esc(formFields.ings)}</textarea>\n      </div>\n      <div class=\"field\">\n        <label>Steps</label>\n        <textarea id=\"f-steps\" class=\"tall\" placeholder=\"Write out the steps…\">${esc(formFields.steps)}</textarea>\n      </div>\n      <div class=\"field\">\n        <label>Notes</label>\n        <textarea id=\"f-notes\" placeholder=\"Tips, variations, substitutions…\">${esc(formFields.notes)}</textarea>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"btn btn-ghost\" onclick=\"cancelForm()\">Cancel</button>\n        <button class=\"btn btn-primary\" onclick=\"doSave()\">Save</button>\n      </div>\n    </div>`;\n}\n\n// ── Render ────────────────────────────────────────────────────────────────────\nfunction render() {\n  const el = document.getElementById(\"layout\");\n  if (!el) return;\n\n  if (view === \"form\") {\n    el.className = \"layout\";\n    el.innerHTML = `<div class=\"full-pane\"><div class=\"full-pane-inner\">${formHtml()}</div></div>`;\n    return;\n  }\n\n  const inDetail = rightView === \"detail\" && !!currentRecipe;\n  el.className = `layout${inDetail ? \" detail-mode\" : \"\"}`;\n  el.innerHTML = `\n    <nav class=\"nav-pane\">${navHtml()}</nav>\n    <div class=\"content-pane\">${inDetail ? detailHtml() : listHtml()}</div>\n  `;\n}\n\n// ── Window globals ────────────────────────────────────────────────────────────\nwindow.openDetail = async function(id) {\n  currentRecipe = await loadRecipeFull(id);\n  rightView = \"detail\"; render();\n};\nwindow.goList = function() {\n  rightView = \"list\"; render();\n};\nwindow.openForm = function() {\n  editingId = null; currentRecipe = null;\n  formDifficulty = \"medium\"; formRating = 0;\n  formFields = { title:\"\", description:\"\", category_id:\"\", servings:\"4\", total_time_mins:\"\", source:\"\", ings:\"\", steps:\"\", notes:\"\" };\n  view = \"form\"; render();\n  setTimeout(() => document.getElementById(\"f-title\")?.focus(), 0);\n};\nwindow.openEdit = async function(id) {\n  currentRecipe  = await loadRecipeFull(id);\n  editingId      = id;\n  formDifficulty = currentRecipe.difficulty ?? \"medium\";\n  formRating     = currentRecipe.rating ?? 0;\n  formFields = {\n    title:           currentRecipe.title            ?? \"\",\n    description:     currentRecipe.description      ?? \"\",\n    category_id:     currentRecipe.category_id      ?? \"\",\n    servings:        String(currentRecipe.servings   ?? 4),\n    total_time_mins: String(currentRecipe.total_time_mins ?? \"\"),\n    source:          currentRecipe.source            ?? \"\",\n    ings:            currentRecipe.ingredients_text  ?? \"\",\n    steps:           currentRecipe.steps_text        ?? \"\",\n    notes:           currentRecipe.notes             ?? \"\",\n  };\n  view = \"form\"; render();\n  setTimeout(() => document.getElementById(\"f-title\")?.focus(), 0);\n};\nwindow.cancelForm = function() {\n  view = \"browse\";\n  render();\n};\nwindow.doSave          = saveRecipe;\nwindow.doDelete        = id => deleteRecipe(id);\nwindow.doToggleFav     = (id, cur) => toggleFavorite(id, cur);\nwindow.doAddToGrocery  = async function() {\n  const btn = document.getElementById(\"grocery-btn\");\n  if (btn) { btn.disabled = true; btn.textContent = \"Adding…\"; }\n  await addToGrocery(currentRecipe);\n  if (btn) { btn.disabled = false; btn.textContent = \"🛒 Add to Grocery\"; }\n};\nwindow.setNav     = f  => { navFilter = f; rightView = \"list\"; render(); };\nwindow.setSearch  = q  => { searchQ  = q; render(); };\nwindow.setSortBy  = s  => { sortBy   = s; render(); };\nwindow.setDiff    = d  => { captureFormFields(); formDifficulty = d; render(); };\nwindow.setRating  = n  => { captureFormFields(); formRating = formRating === n ? 0 : n; render(); };\n\n// ── Toast ─────────────────────────────────────────────────────────────────────\nlet toastTimer = null;\nfunction showToast(msg, type = \"\") {\n  const el = document.getElementById(\"toast\");\n  el.textContent = msg;\n  el.className = `toast${type ? \" \" + type : \"\"} show`;\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(() => { el.className = \"toast\"; }, 3000);\n}\n\n// ── Init ──────────────────────────────────────────────────────────────────────\n(async () => {\n  if (!DB) {\n    recipes = [\n      { id:\"demo-1\", title:\"Spaghetti Bolognese\", difficulty:\"medium\", servings:4, total_time_mins:60, rating:5, category_id:null, is_favorite:0 },\n      { id:\"demo-2\", title:\"Caesar Salad\",        difficulty:\"easy\",   servings:2, total_time_mins:15, rating:4, category_id:null, is_favorite:1 },\n      { id:\"demo-3\", title:\"Chicken Tikka Masala\",difficulty:\"hard\",   servings:4, total_time_mins:90, rating:5, category_id:null, is_favorite:0 },\n    ];\n  } else {\n    await loadAll();\n  }\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "logic.js": "export function formatTime(mins) {\n  if (!mins) return \"\";\n  if (mins < 60) return `${mins}m`;\n  const h = Math.floor(mins / 60), m = mins % 60;\n  return m ? `${h}h ${m}m` : `${h}h`;\n}\n\nexport function difficultyLabel(d) {\n  return { easy: \"Easy\", medium: \"Medium\", hard: \"Hard\" }[d] ?? d;\n}\n\nexport function difficultyColor(d) {\n  return { easy: \"#059669\", medium: \"#d97706\", hard: \"#dc2626\" }[d] ?? \"#6b7280\";\n}\n\nexport function starDisplay(rating) {\n  if (!rating) return \"\";\n  return \"★\".repeat(rating) + \"☆\".repeat(5 - rating);\n}\n\nexport function sortRecipes(list, sort) {\n  const copy = [...list];\n  if (sort === \"rating\") return copy.sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0) || a.title.localeCompare(b.title));\n  if (sort === \"time\")   return copy.sort((a, b) => (a.total_time_mins ?? 9999) - (b.total_time_mins ?? 9999) || a.title.localeCompare(b.title));\n  return copy.sort((a, b) => a.title.localeCompare(b.title));\n}\n"
  }
}