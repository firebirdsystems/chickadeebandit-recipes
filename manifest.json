{
  "id": "recipes",
  "contexts": ["household", "shared_space"],
  "name": "Recipes",
  "version": "1.0.0",
  "description": "A household recipe book with ingredients, steps, categories, ratings, and difficulty. Add any recipe's ingredients directly to your grocery list.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "preload": {
    "recipes": {"sql": "SELECT * FROM app_recipes__recipes ORDER BY title LIMIT 500"},
    "categories": {"sql": "SELECT * FROM app_recipes__categories ORDER BY name"},
    "recipe_categories": {"sql": "SELECT recipe_id, category_id FROM app_recipes__recipe_categories"}
  },
  "db_encryption": "off",
  "category": "family",
  "tags": ["recipes", "food", "cooking", "ingredients"],
  "exports": ["recipes"],
  "data_access": {
    "reads": ["family.members"],
    "writes": ["app.grocery.pending_items"]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "member_references": {
    "recipes": {
      "column": "created_by_id",
      "on_removed": "keep"
    }
  },
  "nav": {
    "label": "Recipes"
  },
  "publishes": ["recipe.added"],
  "publish_acls": {
    "recipe.added": { "require_role": "member" }
  },
  "automation_actions": {
    "add_recipe": {
      "title": "Save a recipe",
      "description": "Put a recipe in the household book when another app's event carries one - something captured from a photo, an email, or a link shared into the house.",
      "params": {
        "created_by_id": {
          "type": "member",
          "label": "Saved for",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "Recipe name",
          "required": true
        },
        "ingredients_text": {
          "type": "text",
          "label": "Ingredients",
          "default": ""
        },
        "steps_text": {
          "type": "text",
          "label": "Steps",
          "default": ""
        },
        "source": {
          "type": "text",
          "label": "Where it came from",
          "default": ""
        }
      },
      "dedupe": {
        "table": "recipes",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "recipes",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "ingredients_text": ":ingredients_text",
            "steps_text": ":steps_text",
            "source": ":source",
            "created_by_id": ":created_by_id",
            "created_by_name": "Automation",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "shareable": {
    "recipe": {
      "table": "recipes",
      "title_column": "title",
      "columns": [
        { "column": "description", "label": "Description", "format": "multiline" },
        { "column": "ingredients_text", "label": "Ingredients", "format": "multiline" },
        { "column": "steps_text", "label": "Steps", "format": "multiline" },
        { "column": "servings", "label": "Servings", "format": "number" },
        { "column": "total_time_mins", "label": "Total time (minutes)", "format": "number" },
        { "column": "difficulty", "label": "Difficulty" },
        { "column": "source", "label": "Source" }
      ],
      "aggregates": [
        {
          "label": "Categories",
          "table": "recipe_categories",
          "fk_column": "recipe_id",
          "op": "list",
          "value_column": "category_id",
          "lookup": { "table": "categories", "label_column": "name" }
        }
      ]
    }
  },
  "icon": "📖",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["all_recipes", "favorites"]
  }
}
