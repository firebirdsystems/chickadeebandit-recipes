{
  "id": "recipes",
  "name": "Recipes",
  "version": "1.0.0",
  "description": "A household recipe book with ingredients, steps, categories, ratings, and difficulty. Add any recipe's ingredients directly to your grocery list.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "db_encryption": "off",
  "category": "family",
  "tags": ["recipes", "food", "cooking", "ingredients"],
  "exports": ["recipes"],
  "data_access": {
    "reads": ["family.members"],
    "writes": ["app.grocery.pending_items"]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "nav": {
    "label": "Recipes"
  },
  "shareable": {
    "recipe": {
      "table": "recipes",
      "title_column": "title",
      "columns": [
        { "column": "description", "label": "Description", "format": "multiline" },
        { "column": "ingredients_text", "label": "Ingredients", "format": "multiline" },
        { "column": "steps_text", "label": "Steps", "format": "multiline" },
        { "column": "servings", "label": "Servings", "format": "number" },
        { "column": "total_time_mins", "label": "Total time (minutes)", "format": "number" },
        { "column": "difficulty", "label": "Difficulty" },
        { "column": "source", "label": "Source" }
      ],
      "aggregates": [
        {
          "label": "Categories",
          "table": "recipe_categories",
          "fk_column": "recipe_id",
          "op": "list",
          "value_column": "category_id",
          "lookup": { "table": "categories", "label_column": "name" }
        }
      ]
    }
  },
  "icon": "📖",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["all_recipes", "favorites"]
  }
}
